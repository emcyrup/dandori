# ============================================================================
#  ナイトだんどり 本番サーバーの設定（./setup.sh が .env を作ります）
#  ★ .env には鍵が入ります。git に入れない・人に送らないでください。
# ============================================================================

# 店舗の名前（半角英数）。stores/<この名前>/ の SQL が流れ、PM2 のプロセス名の頭に付きます
STORE=olivia

# 公開アドレス（末尾の / なし）と、サーバーの nginx が転送してくる先のポート
SITE_URL=https://dandori.olivia.ai-labo.cloud
LISTEN_PORT=8032

# 中の部品が使うポート（127.0.0.1 だけで待つ）。
# 空なら LISTEN_PORT + 30000 から自動で決まる（8032 → 38032 / 38033 / 38034 / 38041〜）。
# ほかの店舗・プロジェクトとぶつかったときだけ入れる
REST_PORT=
AUTH_PORT=
STORAGE_PORT=
FN_BASE_PORT=

# データベース（同じサーバーの PostgreSQL）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dandoriolivia
DB_USER=ai_labo_dbuser
DB_PASSWORD=
DB_SSLMODE=prefer
# 管理者（postgres）のパスワード。入れておくと、役割（anon など）を初回に自動で作ります。
# 配備が終わったら消して構いません
DB_ADMIN_USER=postgres
DB_ADMIN_PASSWORD=

# ---- ここから下は setup.sh が自動で作ります。
#      ★ 同じ PostgreSQL に別の店舗が先に動いているなら、下の3つのパスワードは
#        その店舗の .env と同じ値にしてください（役割はサーバー内で共有のため）
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
AUTHENTICATOR_PASSWORD=
AUTH_ADMIN_PASSWORD=
STORAGE_ADMIN_PASSWORD=

# ---- パスワード再設定・招待メール（Amazon SES など）
SMTP_HOST=email-smtp.ap-northeast-3.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=ナイトだんどり

# ---- サーバー処理の鍵（Supabase の Functions Secrets と同じ。使うものだけ）
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
PIXABAY_API_KEY=

# ---- 送信箱（LINE・メール）を5分ごとに自動で送るなら 1
OUTBOX=0

# ---- Supabase から移すときだけ（Session pooler の接続文字列）。終わったら空に戻す
SOURCE_DB_URL=
