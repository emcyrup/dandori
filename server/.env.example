# ============================================================================
#  ナイトだんどり 本番サーバーの設定（./setup.sh が .env を作ります）
#  ★ .env には鍵が入ります。git に入れない・人に送らないでください。
# ============================================================================

# 公開アドレス（末尾の / なし）と、サーバーの nginx が転送してくる先のポート
SITE_URL=https://dandori.olivia.ai-labo.cloud
LISTEN_PORT=8032

# データベース
#   同じサーバーの PostgreSQL なら host.docker.internal（README の「同じサーバーの DB」を参照）
#   RDS なら、そのエンドポイント
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=dandoriolivia
DB_USER=ai_labo_dbuser
DB_PASSWORD=
# RDS なら require、同じサーバーなら disable か prefer
DB_SSLMODE=prefer

# ---- ここから下は setup.sh が自動で作ります（手で変えない）
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
AUTHENTICATOR_PASSWORD=
AUTH_ADMIN_PASSWORD=
STORAGE_ADMIN_PASSWORD=

# ---- パスワード再設定・招待メール（Amazon SES など）
SMTP_HOST=email-smtp.ap-northeast-3.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=ナイトだんどり

# ---- サーバー処理の鍵（Supabase の Functions Secrets と同じ。使うものだけ）
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
PIXABAY_API_KEY=

# ---- 送信箱を5分ごとに自動で送るなら outbox（使わないなら空）
COMPOSE_PROFILES=

# ---- Supabase から移すときだけ（Session pooler の接続文字列）。終わったら空に戻す
SOURCE_DB_URL=
